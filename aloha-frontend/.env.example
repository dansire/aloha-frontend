# URL base de la API REST de Spring Boot (incluye el prefijo /api si lo usa el backend).
VITE_API_URL=http://localhost:8080/api

# Enviar cookies con cada petición (solo si el backend emite el JWT en una cookie HttpOnly).
VITE_API_WITH_CREDENTIALS=false

# Modo demostración: usa un backend simulado en el navegador (src/demo). NO usar en producción.
VITE_DEMO_MODE=false
